{
  "sourceLanguage": "en",
  "strings": {
    "foreignWindow.accessibility.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج cmux إلى إذن تسهيلات الاستخدام لوضع Claude في هذا الجزء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux benötigt Bedienungshilfen-Zugriff, um Claude in diesem Bereich zu platzieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux needs Accessibility access to place Claude in this pane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux necesita acceso de Accesibilidad para colocar Claude en este panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux a besoin de l’accès Accessibilité pour placer Claude dans ce panneau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペインに Claude を配置するには、cmux にアクセシビリティの許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 이 패널에 Claude를 배치하려면 손쉬운 사용 권한이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 需要辅助功能权限才能将 Claude 放入此窗格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 需要輔助使用權限，才能將 Claude 放入此窗格。"
          }
        }
      }
    },
    "foreignWindow.accessibility.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح إعدادات تسهيلات الاستخدام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen-Einstellungen öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Accessibility Settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes de Accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les réglages d’Accessibilité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ設定を開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 설정 열기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开辅助功能设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開輔助使用設定"
          }
        }
      }
    },
    "foreignWindow.placeholder.shownInOtherPane": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحساب مفتوح في جزء آخر. ركّز على هذا الجزء لعرضه هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto ist in einem anderen Bereich geöffnet. Fokussiere diesen Bereich, um es hier anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is open in another pane. Focus this pane to show it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta está abierta en otro panel. Enfoca este panel para mostrarla aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte est ouvert dans un autre panneau. Activez ce panneau pour l’afficher ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは別のペインで開いています。このペインにフォーカスするとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 다른 패널에서 열려 있습니다. 이 패널에 포커스를 맞추면 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户已在另一个窗格中打开。聚焦此窗格即可在此处显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號已在另一個窗格中開啟。聚焦此窗格即可在此處顯示。"
          }
        }
      }
    },
    "foreignWindow.signInLink.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المتصفح، انقر بزر الماوس الأيمن على ”Open Claude“ واختر نسخ الرابط، ثم انقر على لصق رابط تسجيل الدخول إلى Claude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke im Browser mit der rechten Maustaste auf „Open Claude“, wähle „Link kopieren“ und klicke dann auf „Claude-Anmeldelink einfügen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the browser, right-click “Open Claude” and choose Copy Link, then click Paste Claude sign-in link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el navegador, haz clic derecho en “Open Claude”, elige Copiar enlace y luego haz clic en Pegar enlace de inicio de sesión de Claude."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le navigateur, faites un clic droit sur « Open Claude », choisissez Copier le lien, puis cliquez sur Coller le lien de connexion Claude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで「Open Claude」を右クリックして「リンクをコピー」を選び、「Claude のサインインリンクをペースト」をクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 “Open Claude”를 오른쪽 클릭하고 링크 복사를 선택한 다음 Claude 로그인 링크 붙여넣기를 클릭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中右键点按“Open Claude”并选择“拷贝链接”，然后点按“粘贴 Claude 登录链接”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏覽器中按右鍵點按「Open Claude」並選擇「拷貝連結」，然後點按「貼上 Claude 登入連結」。"
          }
        }
      }
    },
    "foreignWindow.signInLink.helpLabel": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيفية الحصول على رابط تسجيل الدخول"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So erhältst du einen Anmeldelink"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to get a sign-in link"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo obtener un enlace de inicio de sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment obtenir un lien de connexion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインリンクの入手方法"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 링크를 얻는 방법"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何获取登录链接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如何取得登入連結"
          }
        }
      }
    },
    "foreignWindow.signInLink.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي الحافظة على رابط تسجيل الدخول إلى Claude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage enthält keinen Claude-Anmeldelink."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard does not hold a Claude sign-in link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles no contiene un enlace de inicio de sesión de Claude."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers ne contient pas de lien de connexion Claude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードに Claude のサインインリンクがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드에 Claude 로그인 링크가 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板中没有 Claude 登录链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼板中沒有 Claude 登入連結。"
          }
        }
      }
    },
    "foreignWindow.signInLink.notRunning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude لا يعمل في هذا الجزء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude läuft in diesem Bereich nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude is not running in this pane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude no se está ejecutando en este panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude n’est pas en cours d’exécution dans ce panneau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペインでは Claude が実行されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 패널에서 Claude가 실행 중이 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 未在此窗格中运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 未在此窗格中執行。"
          }
        }
      }
    },
    "foreignWindow.signInLink.paste": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لصق رابط تسجيل الدخول إلى Claude"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-Anmeldelink einfügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste Claude sign-in link"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar enlace de inicio de sesión de Claude"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coller le lien de connexion Claude"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude のサインインリンクをペースト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 로그인 링크 붙여넣기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 Claude 登录链接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上 Claude 登入連結"
          }
        }
      }
    },
    "foreignWindow.signInLink.sendFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إرسال الرابط إلى Claude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link konnte nicht an Claude gesendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not send the link to Claude."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar el enlace a Claude."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’envoyer le lien à Claude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを Claude に送信できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 Claude에 보낼 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将链接发送到 Claude。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將連結傳送至 Claude。"
          }
        }
      }
    },
    "foreignWindow.signInLink.sent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال رابط تسجيل الدخول إلى Claude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldelink an Claude gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in link sent to Claude."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlace de inicio de sesión enviado a Claude."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lien de connexion envoyé à Claude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインリンクを Claude に送信しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 링크를 Claude에 보냈습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录链接已发送到 Claude。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入連結已傳送至 Claude。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
