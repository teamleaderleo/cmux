{
  "sourceLanguage": "en",
  "strings": {
    "foreignWindow.accessibility.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج cmux إلى إذن تسهيلات الاستخدام لوضع Claude في هذا الجزء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux benötigt Bedienungshilfen-Zugriff, um Claude in diesem Bereich zu platzieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux needs Accessibility access to place Claude in this pane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux necesita acceso de Accesibilidad para colocar Claude en este panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux a besoin de l’accès Accessibilité pour placer Claude dans ce panneau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペインに Claude を配置するには、cmux にアクセシビリティの許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 이 패널에 Claude를 배치하려면 손쉬운 사용 권한이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 需要辅助功能权限才能将 Claude 放入此窗格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 需要輔助使用權限，才能將 Claude 放入此窗格。"
          }
        }
      }
    },
    "foreignWindow.accessibility.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح إعدادات تسهيلات الاستخدام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen-Einstellungen öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Accessibility Settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes de Accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les réglages d’Accessibilité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ設定を開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 설정 열기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开辅助功能设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開輔助使用設定"
          }
        }
      }
    },
    "foreignWindow.placeholder.shownInOtherPane": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الحساب مفتوح في جزء آخر. ركّز على هذا الجزء لعرضه هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto ist in einem anderen Bereich geöffnet. Fokussiere diesen Bereich, um es hier anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is open in another pane. Focus this pane to show it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta está abierta en otro panel. Enfoca este panel para mostrarla aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte est ouvert dans un autre panneau. Activez ce panneau pour l’afficher ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは別のペインで開いています。このペインにフォーカスするとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 다른 패널에서 열려 있습니다. 이 패널에 포커스를 맞추면 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户已在另一个窗格中打开。聚焦此窗格即可在此处显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號已在另一個窗格中開啟。聚焦此窗格即可在此處顯示。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
