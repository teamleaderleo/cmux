+#[cfg(unix)]
+enum EnqueuePendingResult {
+    Enqueued,
+    Full(Value),
+}
+
+#[cfg(unix)]
+fn pending_record_bytes(record: &Value) -> usize {
+    serde_json::to_vec(record).map_or(MAX_PENDING_BYTES.saturating_add(1), |bytes| bytes.len())
+}
