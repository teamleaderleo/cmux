+#[cfg(unix)]
+async fn enqueue_pending_with_backpressure(
+    shared: &Shared,
+    session_name: &str,
+    cursor_key: &str,
+    generation: &Option<String>,
+    mut record: Value,
+) -> bool {
+    loop {
+        // Register before checking capacity so a completion wake cannot land
+        // in the gap between observing Full and beginning to wait.
+        let mut capacity = Box::pin(shared.pool_capacity_wake.notified());
+        capacity.as_mut().enable();
+        match enqueue_pending(shared, session_name, cursor_key, generation, record) {
+            EnqueuePendingResult::Enqueued => return true,
+            EnqueuePendingResult::Full(returned) => record = returned,
+        }
+        tokio::select! {
+            biased;
+            _ = shared.cancellation.cancelled() => return false,
+            _ = &mut capacity => {}
+        }
+    }
+}
