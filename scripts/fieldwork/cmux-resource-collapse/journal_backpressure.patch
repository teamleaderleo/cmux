+    async fn busy_pool_backpressures_after_one_bounded_pending_batch() {
+        let (root, path) = cursor_test_path("pool-backpressure-records").await;
+        let (shared, _wake) = test_shared(String::from("http://127.0.0.1:9"), path);
+        let generation = Some(String::from("gen_a"));
+        {
+            let mut pool = shared.pool.lock().expect("lock pool");
+            pool.flushing = true;
+        }
+        for sequence in 1..=MAX_PENDING_RECORDS {
+            assert!(matches!(
+                enqueue_pending(
+                    &shared,
+                    "alpha",
+                    "alpha",
+                    &generation,
+                    record("gen_a", &sequence.to_string()),
+                ),
+                EnqueuePendingResult::Enqueued
+            ));
+        }
+        let overflow = enqueue_pending(
+            &shared,
+            "alpha",
+            "alpha",
+            &generation,
+            record("gen_a", &(MAX_PENDING_RECORDS + 1).to_string()),
+        );
+        assert!(matches!(overflow, EnqueuePendingResult::Full(_)));
+        {
+            let pool = shared.pool.lock().expect("lock pool");
+            assert_eq!(pool.pending_records, MAX_PENDING_RECORDS);
+            assert_eq!(
+                pool.pending.iter().map(|entry| entry.records.len()).sum::<usize>(),
+                MAX_PENDING_RECORDS
+            );
+        }
+
+        let blocked_shared = shared.clone();
+        let blocked_generation = generation.clone();
+        let blocked = tokio::spawn(async move {
+            enqueue_pending_with_backpressure(
+                &blocked_shared,
+                "alpha",
+                "alpha",
+                &blocked_generation,
+                record("gen_a", "1000"),
+            )
+            .await
+        });
+        tokio::time::sleep(Duration::from_millis(20)).await;
+        assert!(!blocked.is_finished(), "the 101st busy record must wait for pool capacity");
+        shared.cancellation.cancel();
+        assert!(!blocked.await.expect("blocked producer task"));
+        remove_cursor_test_path(&root).await;
+    }
